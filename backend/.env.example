# Setup in backend/: npm ci, then npm run db:migrate, then npm run dev.
# Production: npm run build, then npm start; run migrations as a separate step.
# Import your catalog with npm run catalog:import -- path/to/catalog.json.
# Schedule npm run account:recover every minute to finish interrupted deletions.
# Copy to backend/.env. Never put server credentials in frontend/mobile env files.
NODE_ENV=development
PORT=4000

# Neon pooled endpoint for API traffic; replace placeholders with your own values.
# Certificate verification is always enabled for remote PostgreSQL connections.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST.neon.tech/neondb?sslmode=verify-full
# Direct endpoint for explicit migrations and atomic catalog imports.
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST.neon.tech/neondb?sslmode=verify-full
PG_POOL_MAX=10

# Comma separated exact browser origins. Use HTTPS origins in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set only to the exact trusted reverse proxy count; leave 0 for direct traffic.
TRUST_PROXY_HOPS=0

# Same Firebase project used by web and mobile. Enable Email/Password in Firebase.
FIREBASE_PROJECT_ID=
# Choose service account env credentials OR GOOGLE_APPLICATION_CREDENTIALS / ADC.
FIREBASE_CLIENT_EMAIL=
# PEM with escaped newlines (\\n), not a public Firebase web API key.
FIREBASE_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/service-account.json
# Do not set FIREBASE_AUTH_EMULATOR_HOST in production.
