# Setup in frontend/: npm ci, then npm run dev. Build with npm run build.
# Copy this template to .env and use the same Firebase project as backend and mobile.
# Public client configuration, bundled at build time. Never put database or Admin secrets here.
# Leave VITE_API_URL=/api when the web host reverse-proxies /api to the backend.
VITE_API_URL=/api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
