# Setup in mobile/: npm ci, then npm start. Copy this template to .env first.
# Use the same Firebase project as backend and web. Phones need a reachable API URL.
# Public application configuration only. Neon and Firebase Admin secrets belong on the backend.
EXPO_PUBLIC_API_URL=https://api.your-domain.example/api
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
